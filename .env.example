# Copy this file to .env.local and fill in the values.

# --- Required ---------------------------------------------------------------

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Signs sessions and reset links. Optional in development, required in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database ---------------------------------------------------------------

# Leave unset in development to use the embedded database in .data/pglite.
# In production: any Postgres connection string (use the pooled URL on serverless hosts).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Optional ---------------------------------------------------------------

# The app's public URL. Detected automatically on localhost and on Vercel.
# BETTER_AUTH_URL=https://your-domain.com

# "Continue with GitHub": https://github.com/settings/developers
# Callback URL: <your URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# "Continue with Google": https://console.cloud.google.com/apis/credentials
# Redirect URI: <your URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Password-reset emails through https://resend.com. In development they're printed to the terminal.
# RESEND_API_KEY=
# EMAIL_FROM="AI Gym Coach <coach@your-domain.com>"

# Cost controls: analyses allowed per user, and across all users, in any rolling 24 hours.
# DAILY_ANALYSIS_LIMIT=10
# GLOBAL_DAILY_ANALYSIS_LIMIT=200

# Comma-separated Gemini models to try in order (the first that works wins).
# GEMINI_MODEL=gemini-2.5-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-latest
